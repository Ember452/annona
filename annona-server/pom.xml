<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.annona</groupId>
        <artifactId>annona</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>annona-server</artifactId>
    <packaging>jar</packaging>
    <name>annona-server</name>
    <description>应用层：唯一可执行 jar。全部业务模块 + Web/SSE/WS 接口 + 启动类 + CLI + prompt 与 skill 资源。</description>

    <dependencies>
        <dependency>
            <groupId>io.annona</groupId>
            <artifactId>annona-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.annona</groupId>
            <artifactId>annona-spi</artifactId>
        </dependency>
        <!-- 编译期不直接依赖 infrastructure 的具体实现类；运行期由 Spring 装配 SPI 实现。
             ArchUnit 规则强制 io.annona.modules.. 不 import io.annona.infrastructure..。 -->
        <dependency>
            <groupId>io.annona</groupId>
            <artifactId>annona-infrastructure</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Boot 4 模块化的 starter 名（详见 docs/annona-开发计划.md 借鉴地图 A 表）：
             - spring-boot-starter：核心 + 日志
             - spring-boot-starter-webmvc：MVC + Jackson + Tomcat（原 -web 已改名） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- B2 启动与基线：P0-05/P0-06/P0-08 共同引入
             - starter-flyway：Flyway autoconfig（Boot 4 已改名，不是 -flyway-core）
             - starter-data-jpa：为 P0-06 验收项 "ddl-auto: validate 下应用可启动" 提供 autoconfig（本阶段无 Entity，validate 空跑）
             - starter-actuator：为线程池提供 MeterRegistry Bean，支撑 Micrometer 绑定（AGENTS.md 借鉴地图 A 表“池名与 Micrometer 指标绑定”硬约束） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- B3 (P0-09) 前端 OpenAPI 类型生成需要 /v3/api-docs 与 Swagger UI；
             Boot 4 兼容的 springdoc 版本由根 pom 的 dependencyManagement 控制（当前 3.1.1）。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- runtime scope：驱动与 PG 方言（Boot 的 starter-flyway 不自带 postgres 方言） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>annona-server</finalName>
        <plugins>
            <!-- 只有 annona-server 打成可执行 Boot jar；其他三个模块是普通 library jar。
                 版本由 spring-boot-starter-parent 的 pluginManagement 提供。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.annona.AnnonaApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
