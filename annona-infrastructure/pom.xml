<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.annona</groupId>
        <artifactId>annona</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>annona-infrastructure</artifactId>
    <packaging>jar</packaging>
    <name>annona-infrastructure</name>
    <description>技术实现层：SPI 的具体实现与外部系统适配（PG/pgvector、Redis、S3、LLM HTTP、加密、PDF、分词）。P0 只有包骨架；P1a 起落入实现。</description>

    <dependencies>
        <dependency>
            <groupId>io.annona</groupId>
            <artifactId>annona-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.annona</groupId>
            <artifactId>annona-spi</artifactId>
        </dependency>

        <!-- P1a-01：Redisson 会话存储。本模块是外部系统适配层（见 package-info），
             Redis 客户端属基础设施，故 Redisson 依赖落在此处而非 annona-server。
             spring-boot-starter 提供 @Configuration/@Component 与 @ConfigurationProperties 支撑。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>

        <!-- P1a-05：Tika 文档解析（AutoDetect：PDF/DOCX/TXT/MD）。tika-core 是 API，
             standard-package 聚合全部标准解析器实现。 -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
        </dependency>
        <!-- P1a-05：embedding HTTP 编解码用 Jackson（infrastructure 不依赖 web starter） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!-- P1a-05：S3 兼容对象存储（AWS SDK v2，forcePathStyle 对接 PGSTY Silo；
             apache-client 是同步 S3Client 的 HTTP 层） -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
        </dependency>

        <!-- P1a-07：应用层中文分词（端口在 common/search，本模块是实现方，见结构文档 §3
             "分词"职责行）。jieba 自带的 commons-lang3:3.3.1 已在根 pom 的
             dependencyManagement 里排除，版本由 Boot/Tika 的上收版本接管
             （否则 enforcer 的 requireUpperBoundDeps 会在 validate 响）。 -->
        <dependency>
            <groupId>com.huaban</groupId>
            <artifactId>jieba-analysis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- AGENTS.md §4 把"infrastructure 的分词"点名为 85% 关键纯逻辑包。卡 CLASS +
                 类名通配（与 annona-server 的 key-logic-coverage-check 同一写法）：
                 PACKAGE/BUNDLE 的 includes 写错会匹配零元素静默通过。prepare-agent 与 report
                 由根 pom 继承——分词器的测试就在本模块，agent 数据也落在这。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>search-coverage-check</id>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>io/annona/infrastructure/search/*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
