<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.annona</groupId>
    <artifactId>annona</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>annona-common</module>
        <module>annona-spi</module>
        <module>annona-infrastructure</module>
        <module>annona-server</module>
    </modules>
    <name>annona</name>
    <description>年轮 · annona — study minutes become the shape of your next question.</description>
    <url>https://github.com/Ember452/annona</url>
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>ember452</id>
            <url>https://github.com/Ember452</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/Ember452/annona.git</connection>
        <developerConnection>scm:git:git@github.com:Ember452/annona.git</developerConnection>
        <url>https://github.com/Ember452/annona</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 第三方版本只在这一处出现；子模块的 <dependency> 一律不写 version -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <archunit.version>1.3.0</archunit.version>
        <!-- springdoc-openapi 3.x 适配 Spring Boot 4（官方 FAQ：https://springdoc.org/faq.html）。
             2.x 只兼容 Boot 3；上 Boot 4 后不能直接升到 2.x 最后一版。 -->
        <springdoc.version>3.1.1</springdoc.version>
        <!-- Boot 4.1.1 默认 Jackson BOM = 2.21.5；springdoc 3.1.1 内部 swagger-core-jakarta
             2.2.55 拉 2.22.1，不升级会触发 enforcer 的 requireUpperBoundDeps 失败。
             Boot 4 分家管两个 Jackson BOM：jackson-2-bom.version = fasterxml（legacy Jackson 2），
             jackson-bom.version = tools.jackson（Jackson 3）。本 override 只针对 Jackson 2。 -->
        <jackson-2-bom.version>2.22.1</jackson-2-bom.version>

        <!-- Mockito 在 JDK 21 上动态 attach 会告警，显式放行（surefire 与 CI 同一口径） -->
        <annona.test.jvmArgs>--enable-native-access=ALL-UNNAMED</annona.test.jvmArgs>

        <!-- 本机无 Docker：默认排除需真实中间件的 docker 组测试。必须走属性而不是在
             <configuration> 里直写 `docker`——Maven 的 POM 显式配置优先于 `-D` 用户属性，
             直写会让 CI 的 `-DexcludedGroups=` 失效，导致集测 0 个测试仍然 BUILD SUCCESS。
             （已实测：-Dgroups=docker → Tests run: 0 且绿；-DexcludedGroups= 仍不跑 *IT） -->
        <annona.tests.excluded>docker</annona.tests.excluded>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块坐标集中在父 pom；子模块引用不写 version -->
            <dependency>
                <groupId>io.annona</groupId>
                <artifactId>annona-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.annona</groupId>
                <artifactId>annona-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.annona</groupId>
                <artifactId>annona-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- spring-boot-starter-parent 已管理 Boot 生态版本；这里只补 AI 侧的 BOM。
                 2.0.0 已确认可从 Maven Central 直接解析，不需要 repo.spring.io/milestone。 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ArchUnit 由 annona-server 的 test scope 引入，版本集中管理 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- springdoc-openapi 自动装配 OpenAPI 3 文档与 Swagger UI（annona-server 引入）。
                 与 P0-09 前端 OpenAPI 类型生成脚本直接相关（pnpm gen:api 拉 /v3/api-docs）。
                 Boot 4 不自动管理 springdoc 版本，因此需显式声明。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 未被 Boot 父 POM 管理的插件版本在此集中，子模块继承即可 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-project-rules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <fail>true</fail>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>annona 需要 JDK 21 及以上（见 docs/annona-项目结构.md §11）。</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>Maven 3.9 以下版本不受支持，请使用 ./mvnw。</message>
                                </requireMavenVersion>

                                <!-- 依赖冲突上收到根 pom：避免子模块各自传递出不同版本 -->
                                <requireUpperBoundDeps/>

                                <!-- 存储栈已收敛为 PostgreSQL + Redis + S3，
                                     见 docs/specs/2026-09-25-storage-single-postgres-adr.md。
                                     任何人（或 AI）误加回 MySQL/Mongo/ES 依赖时，构建直接失败。 -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>mysql:mysql-connector-java</exclude>
                                        <exclude>com.mysql:mysql-connector-j</exclude>
                                        <exclude>org.mariadb.jdbc:*</exclude>
                                        <exclude>org.mongodb:*</exclude>
                                        <exclude>org.elasticsearch*:*</exclude>
                                        <exclude>co.elastic.clients:*</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 本机无 Docker：默认排除需要真实中间件的测试，由 CI 以
                         `-Dannona.tests.excluded= -Dgroups=docker` 专跑该组。
                         见 docs/specs/2026-09-25-dockerless-local-dev-adr.md -->
                    <excludedGroups>${annona.tests.excluded}</excludedGroups>
                    <argLine>${annona.test.jvmArgs}</argLine>
                    <!-- 把 *IT.java 也纳入 surefire（默认只扫 *Test.java）。
                         annona 约定：@Tag("docker") 的集成测试统一 *IT.java 后缀，与
                         纯单测 *Test.java 区分；CI 靠 groups 参数筛，不靠文件名。
                         若改日引入 maven-failsafe，把 *IT.java 从 surefire 扫到 failsafe 扫。 -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
