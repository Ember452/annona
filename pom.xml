<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>io.annona</groupId>
    <artifactId>annona</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>annona-common</module>
        <module>annona-spi</module>
        <module>annona-infrastructure</module>
        <module>annona-server</module>
    </modules>
    <name>annona</name>
    <description>年轮 · annona — study minutes become the shape of your next question.</description>
    <url>https://github.com/Ember452/annona</url>
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>ember452</id>
            <url>https://github.com/Ember452</url>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/Ember452/annona.git</connection>
        <developerConnection>scm:git:git@github.com:Ember452/annona.git</developerConnection>
        <url>https://github.com/Ember452/annona</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 第三方版本只在这一处出现；子模块的 <dependency> 一律不写 version -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <archunit.version>1.3.0</archunit.version>
        <!-- springdoc-openapi 3.x 适配 Spring Boot 4（官方 FAQ：https://springdoc.org/faq.html）。
             2.x 只兼容 Boot 3；上 Boot 4 后不能直接升到 2.x 最后一版。 -->
        <springdoc.version>3.1.1</springdoc.version>
        <!-- Boot 4.1.1 默认 Jackson BOM = 2.21.5；springdoc 3.1.1 内部 swagger-core-jakarta
             2.2.55 拉 2.22.1，不升级会触发 enforcer 的 requireUpperBoundDeps 失败。
             Boot 4 分家管两个 Jackson BOM：jackson-2-bom.version = fasterxml（legacy Jackson 2），
             jackson-bom.version = tools.jackson（Jackson 3）。本 override 只针对 Jackson 2。 -->
        <jackson-2-bom.version>2.22.1</jackson-2-bom.version>
        <!-- P1a-01：会话用 Redisson（单客户端覆盖 session/限流/Stream/在线共学），
             Entity→DTO 映射用 MapStruct（AGENTS.md §4 全仓统一）。Boot BOM 不管这两个，需显式 pin。
             scrypt 用 spring-security-crypto，其版本由 spring-boot-dependencies 管理，不写。 -->
        <redisson.version>3.34.1</redisson.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- BouncyCastle：spring-security-crypto 的 SCryptPasswordEncoder 运行期依赖（未传递），
             版本上收到根 pom 统一管理；1.81.1 为 Tika 3.2.1 的 RequireUpperBoundDeps 下限（P1a-05） -->
        <bcprov.version>1.81.1</bcprov.version>
        <!-- P1a-05：Tika 文档解析与 AWS S3 SDK（对象存储，对接 PGSTY Silo），版本集中管理 -->
        <tika.version>3.2.1</tika.version>
        <!-- P1a-07 关键词通道的应用层分词器（retrieval-hybrid-adr §决策 10 四问）。1.0.2 是 Central
             最新版且自 2015-06-17 未动过（冻结型稳）；它带 commons-lang3:3.3.1 传递依赖，必须
             上收到收敛版本，否则 enforcer 的 requireUpperBoundDeps 会在 validate 直接响。 -->
        <jieba.version>1.0.2</jieba.version>
        <aws-sdk.version>2.30.31</aws-sdk.version>

        <!-- Mockito 在 JDK 21 上动态 attach 会告警，显式放行（surefire 与 CI 同一口径） -->
        <annona.test.jvmArgs>--enable-native-access=ALL-UNNAMED</annona.test.jvmArgs>

        <!-- JaCoCo 覆盖率（P1a 起兑现 AGENTS §4 的阈值承诺：其余 60%、关键纯逻辑包 85%）。
             jacoco.argLine 默认留空：surefire 的 argLine 拼接它，prepare-agent 未跑时也不至于
             把字面量 ${jacoco.argLine} 喂给 JVM。接入记录见 2026-09-27 加固批。 -->
        <jacoco.version>0.8.12</jacoco.version>
        <jacoco.argLine></jacoco.argLine>

        <!-- 本机无 Docker：默认排除需真实中间件的 docker 组测试。必须走属性而不是在
             <configuration> 里直写 `docker`——Maven 的 POM 显式配置优先于 `-D` 用户属性，
             直写会让 CI 的 `-DexcludedGroups=` 失效，导致集测 0 个测试仍然 BUILD SUCCESS。
             （已实测：-Dgroups=docker → Tests run: 0 且绿；-DexcludedGroups= 仍不跑 *IT） -->
        <annona.tests.excluded>docker</annona.tests.excluded>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- JUnit BOM 显式导入并置于所有自带 BOM 之前：spring-ai-bom 2.0.0 内嵌的
                 junit 5.13.2 管理会以"先到先得"压过 Boot 父链的 junit-bom 6.0.3，而
                 spring-test 7 依赖 jupiter 6 的 Store.computeIfAbsent（缺它 = 上下文测试
                 NoSuchMethodError，P1a-05 实测）。版本取 Boot 的 junit-jupiter.version 属性保持对齐。 -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块坐标集中在父 pom；子模块引用不写 version -->
            <dependency>
                <groupId>io.annona</groupId>
                <artifactId>annona-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.annona</groupId>
                <artifactId>annona-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.annona</groupId>
                <artifactId>annona-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- spring-boot-starter-parent 已管理 Boot 生态版本；这里只补 AI 侧的 BOM。
                 2.0.0 已确认可从 Maven Central 直接解析，不需要 repo.spring.io/milestone。
                 注意：截至 P1a 四个模块尚无任何 spring-ai 依赖（零引用），本 BOM 是为
                 P1b-02/06 的模型接入预置的版本钉——首个真实依赖进来时复核版本仍受支持，
                 若届时 P1b 改用自研 ModelProvider 网关则移除本条。 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Jackson 2 BOM 显式导入：Boot 父链靠 jackson-2-bom.version 属性管理 jackson-bom，
                 但本仓自己 import 的 BOM（tika/aws）按"先到先得"压过父链管理——tika-bom 携带的
                 jackson 2.19.1 会覆盖 Boot 的 2.22.1（jsr310 上收冲突，P1a-05 实测）。
                 放在所有自带 BOM 之前，让 2.22.1 保持权威。 -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-2-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- P1a-05：Tika（解析）与 AWS SDK（S3 存储）BOM，子模块引用不写 version -->
            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-bom</artifactId>
                <version>${tika.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ArchUnit 由 annona-server 的 test scope 引入，版本集中管理 -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- springdoc-openapi 自动装配 OpenAPI 3 文档与 Swagger UI（annona-server 引入）。
                 与 P0-09 前端 OpenAPI 类型生成脚本直接相关（pnpm gen:api 拉 /v3/api-docs）。
                 Boot 4 不自动管理 springdoc 版本，因此需显式声明。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- P1a-01 会话存储（Redisson）与 MapStruct 映射；版本上收到此处，子模块不写 version。 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bcprov.version}</version>
            </dependency>
            <!-- P1a-07 中文分词（端口在 common/search，实现在 infrastructure/search）。
                 只排除 2014 年的 commons-lang3：版本由 Boot/Tika 的上收版本接管，jieba 用到的
                 StringUtils 在新版本里签名未变。排除后 golden 切词单测负责证明它能跑。 -->
            <dependency>
                <groupId>com.huaban</groupId>
                <artifactId>jieba-analysis</artifactId>
                <version>${jieba.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.apache.commons</groupId>
                        <artifactId>commons-lang3</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <!-- Tika 3.2.1 声明 log4j-to-slf4j 2.25.5，高于 Boot 管理的 2.25.0；
                 钉到确实存在的 2.26.0 满足上收（适配器，无行为耦合），log4j-api 随同 -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-to-slf4j</artifactId>
                <version>2.26.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>2.26.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 未被 Boot 父 POM 管理的插件版本在此集中，子模块继承即可 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-project-rules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <fail>true</fail>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>annona 需要 JDK 21 及以上（见 docs/annona-项目结构.md §11）。</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>Maven 3.9 以下版本不受支持，请使用 ./mvnw。</message>
                                </requireMavenVersion>

                                <!-- 依赖冲突上收到根 pom：避免子模块各自传递出不同版本。
                                     jackson-annotations 豁免：其 2.x 版本线冻结在 2.19.x
                                     （Boot 4 的 jackson-2 BOM 也如此管理），Tika 3.2.x 声明的
                                     "2.21" 是不可解析的幽灵声明——按声明版本比较必然失败，
                                     managed 2.19.1 即事实上的最新版。 -->
                                <requireUpperBoundDeps>
                                    <excludes>
                                        <exclude>com.fasterxml.jackson.core:jackson-annotations</exclude>
                                    </excludes>
                                </requireUpperBoundDeps>

                                <!-- 存储栈已收敛为 PostgreSQL + Redis + S3，
                                     见 docs/specs/2026-09-25-storage-single-postgres-adr.md。
                                     任何人（或 AI）误加回 MySQL/Mongo/ES 依赖时，构建直接失败。 -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>mysql:mysql-connector-java</exclude>
                                        <exclude>com.mysql:mysql-connector-j</exclude>
                                        <exclude>org.mariadb.jdbc:*</exclude>
                                        <exclude>org.mongodb:*</exclude>
                                        <exclude>org.elasticsearch*:*</exclude>
                                        <exclude>co.elastic.clients:*</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!-- 所有模块继承：agent 挂到 surefire；check（阈值门槛）只在需要它的
                         模块 pom 里单独声明（annona-server），避免 spi/common 这类
                         "自身模块内测试覆盖不了被 server 消费的代码"的模块被误伤 -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                        <configuration>
                            <propertyName>jacoco.argLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 本机无 Docker：默认排除需要真实中间件的测试，由 CI 以
                         `-Dannona.tests.excluded= -Dgroups=docker` 专跑该组。
                         见 docs/specs/2026-09-25-dockerless-local-dev-adr.md -->
                    <excludedGroups>${annona.tests.excluded}</excludedGroups>
                    <!-- jacoco.argLine 由根 build 的 prepare-agent 注入；必须用 @{...} 运行期求值——
                         ${...} 会在模型构建期被 properties 里的空默认值替换，agent 根本挂不上
                         （实测：报告提示 missing execution data file 且 0 覆盖） -->
                    <argLine>@{jacoco.argLine} ${annona.test.jvmArgs}</argLine>
                    <!-- 把 *IT.java 也纳入 surefire（默认只扫 *Test.java）。
                         annona 约定：@Tag("docker") 的集成测试统一 *IT.java 后缀，与
                         纯单测 *Test.java 区分；CI 靠 groups 参数筛，不靠文件名。
                         若改日引入 maven-failsafe，把 *IT.java 从 surefire 扫到 failsafe 扫。 -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
