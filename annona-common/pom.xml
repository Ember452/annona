<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.annona</groupId>
        <artifactId>annona</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>annona-common</artifactId>
    <packaging>jar</packaging>
    <name>annona-common</name>
    <description>通用能力层：统一响应、异常体系、错误码、常量、切面基类；不含业务概念</description>

    <dependencies>
        <!-- 零框架依赖：本模块只放 Result / ErrorCode / BusinessException 与端口契约。
             需要 Spring 的全局异常出口已移到 annona-server 的 config/web（原因见该类注释）。
             对 spi 的依赖不破坏这条约束（spi 自身零框架，批 3 usage 契约变更使然：
             ChatStreamListener 终态回调携带 UsageInfo，理由与重评条件见
             docs/specs/2026-09-29-llmprovider-metering-adr.md 批 3 修订）。 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.annona</groupId>
            <artifactId>annona-spi</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
