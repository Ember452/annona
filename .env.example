# annona 环境变量模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，绝不提交。
# 本文件只允许出现占位符，任何真实 Key 出现在仓库中都是事故（见 AGENTS.md §0.2、
# docs/specs/2026-09-25-model-api-key-adr.md）。

# ============ 必改（生产环境缺失即启动失败）============
# 模型 API Key 的加密主密钥（KEK）。生成方式：openssl rand -base64 32
# 与密文分离存储；生产环境建议改由 KMS / Vault / 秘密管理服务注入
ANNONA_SECRET_KEY=replace-me-kek

# ============ 数据库与缓存（本机开发可留默认值）============
# PostgreSQL 16 + pgvector；开发期无 Docker，需自行准备实例
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/annona
SPRING_DATASOURCE_USERNAME=annona
SPRING_DATASOURCE_PASSWORD=replace-me
# Redis（会话、限流、Stream、在线状态；本机开发需自行准备）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============ 对象存储（S3 兼容；实现选型 PGSTY Silo，见 docs/specs/2026-09-26-s3-storage-silo-adr.md）============
# S3_ENABLED 显式开关（默认 false）：true 时上方四项缺一不可，应用启动即校验；
# false 时 storage bean 不装配，上传文档报 2306。compose 栈内置 true。
S3_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=annona
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# ============ 运行模式（双轨部署开关，见设计文档 §13）============
# identity: local（注册/登录）| platform（托管账号）| none（单机免登录，无需上面数据库账号体系）
ANNONA_IDENTITY_MODE=local
# 仅 platform 模式生效：受信反向代理注入的身份头（默认 X-Auth-Request-Email）。
# ⚠️ 信任边界：反代必须剥离客户端自带的同名头，且本实例不得被直连，否则可伪造任意身份。
# ⚠️ 切 platform 前先读 deploy/nginx/annona.conf 顶部的平台模式加固说明（本仓库自带
#    的 nginx 配置只按 local 模式配好，直接沿用会被头走私伪造身份）。
ANNONA_IDENTITY_PLATFORM_HEADER=X-Auth-Request-Email
# 可选（推荐生产启用）：代码强制的代理来源共享密钥。留空=仅靠上面的文档约定；一旦设置，
# 每个 platform 请求必须携带匹配的 ANNONA_IDENTITY_PLATFORM_SECRET_HEADER 头（常数时间比较），
# 否则视为未认证——即使实例被直连也无法伪造身份。反代须注入并剥离该头。
ANNONA_IDENTITY_PLATFORM_SECRET=
ANNONA_IDENTITY_PLATFORM_SECRET_HEADER=X-Auth-Request-Access-Token
# ⚠️ 尚未接线（P1b-10 usage/key 落地时生效）：当前配置了也不会被读取
ANNONA_MODEL_MODE=byok
# ⚠️ 尚未接线：邮箱验证流未实现（P1b 前不做，见 identity ADR）；当前配置无效
ANNONA_IDENTITY_REQUIRE_EMAIL_VERIFICATION=false

# ============ 会话（identity=local/platform 时生效）============
# 活跃令牌是不透明随机串、只存 Redis，没有签名/加密密钥（identity-credential-storage-adr §决策 §3）
# 滑动有效期；Cookie 名固定 ANNONA_SESSION（HttpOnly），此处不配
ANNONA_SESSION_TTL=7d
# TLS 部署（https 或反代 https）必须置 true，否则会话 Cookie 走明文信道。
# prod profile 默认已强制 true（yaml 显式声明）；docker profile 是 http 自部署链路，保持 false
ANNONA_SESSION_COOKIE_SECURE=false

# ============ 模型 Provider（⚠️ 尚未接线，P1b-10 落地 usage/key 时生效；当前填写不会被读取）============
# OpenAI 兼容协议；一个 Provider 可服务 chat/embedding/asr/tts/evaluator 多种用途
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 通义千问（DashScope，OpenAI 兼容 + 语音 ASR/TTS 同源）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地模型（LM Studio / Ollama 等 OpenAI 兼容端点）
LOCAL_MODEL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL_API_KEY=not-needed

# ⚠️ chat/evaluator 尚未接线（P1b-10）；embedding 已接线（P1a-05，knowledge-ingestion-adr）
ANNONA_DEFAULT_CHAT_MODEL=
# embedding 模型 id；同时是 kb_doc.embedding_model 落库口径（provider=openai-compatible 时必填）
ANNONA_DEFAULT_EMBEDDING_MODEL=
ANNONA_DEFAULT_EVALUATOR_MODEL=

# ============ Embedding 通道（P1a-05 接线）============
# none = 关闭向量化（上传后停在 FAILED，报 2310）；openai-compatible = OpenAI /embeddings 协议
# fake = 确定性 1024 维向量（P1a-09 无 Key 环境的管道回归用）。**它的召回数字不可读作质量**：
# fake 向量与语义无关，检索按 kb_doc.embedding_model 过滤，真模型与 fake 两套语料不可混比
# （retrieval-hybrid-adr §决策 9）；另：docker 组 IT 自己提供 embedding bean，给它打 fake 会装出两个候选。
ANNONA_MODEL_EMBEDDING_PROVIDER=none
# 端点与 Key：provider=openai-compatible 时必填；如 DASHSCOPE_BASE_URL + DASHSCOPE_API_KEY
ANNONA_EMBEDDING_BASE_URL=
ANNONA_EMBEDDING_API_KEY=
# 维度必须与 V4 迁移的 vector(1024) 一致；改维度 = 新迁移（ADR 禁改）
ANNONA_EMBEDDING_DIMENSIONS=1024

# ============ 检索后端（P1a-07 已接线）============
# pgvector（默认）= 语义(HNSW) + 关键词(tsv / pg_trgm 包含兜底) + RRF 整套机器；fake = 内存空命中。
# **只接受这两个值**：写未知值（含 elasticsearch）会在启动被拒——默认不部署 ES
#（storage-single-postgres-adr；EsRetriever 只是 SPI 保留的退路，尚未实现）。
ANNONA_RETRIEVAL_BACKEND=pgvector
# 下列三项属于未实现的 EsRetriever，当前代码不读它们（不要误以为设了就能用）
ELASTICSEARCH_URIS=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============ 可选：联网搜索降级（⚠️ 尚未接线，P1a-07 retrieval/fallback 批生效）============
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# ============ 服务端口与前端地址 ============
SERVER_PORT=8080
# ⚠️ 尚未接线：CORS 未配置（同源部署不需要；需要前后端分体部署时先补 CORS 配置，见 P0 报告 D2）
FRONTEND_ORIGIN=http://localhost:5173

# ============ 可观测（可选）============
# ⚠️ OTLP 未接线（无 opentelemetry 依赖，引入前此值无效）
OTEL_EXPORTER_OTLP_ENDPOINT=
# 默认已含 health,metrics；prometheus 需要 micrometer-registry-prometheus 依赖（未引入前该值写了也是 404）
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics
