# annona 环境变量模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，绝不提交。
# 本文件只允许出现占位符，任何真实 Key 出现在仓库中都是事故（见 AGENTS.md §0.2、
# docs/specs/2026-09-25-model-api-key-adr.md）。

# ============ 必改（生产环境缺失即启动失败）============
# 模型 API Key 的加密主密钥（KEK）。生成方式：openssl rand -base64 32
# 与密文分离存储；生产环境建议改由 KMS / Vault / 秘密管理服务注入
ANNONA_SECRET_KEY=replace-me-kek

# ============ 数据库与缓存（本机开发可留默认值）============
# PostgreSQL 16 + pgvector；开发期无 Docker，需自行准备实例
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/annona
SPRING_DATASOURCE_USERNAME=annona
SPRING_DATASOURCE_PASSWORD=replace-me
# Redis（会话、限流、Stream、在线状态；本机开发需自行准备）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============ 对象存储（S3 兼容；实现选型 PGSTY Silo，见 docs/specs/2026-09-26-s3-storage-silo-adr.md）============
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=annona
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# ============ 运行模式（双轨部署开关，见设计文档 §13）============
# identity: local（注册/登录）| platform（托管账号）| none（单机免登录，无需上面数据库账号体系）
ANNONA_IDENTITY_MODE=local
# 仅 platform 模式生效：受信反向代理注入的身份头（默认 X-Auth-Request-Email）。
# ⚠️ 信任边界：反代必须剥离客户端自带的同名头，且本实例不得被直连，否则可伪造任意身份。
ANNONA_IDENTITY_PLATFORM_HEADER=X-Auth-Request-Email
# model: byok（用户自带 Key）| platform-held（平台代持，必须先有 token 配额与熔断）
ANNONA_MODEL_MODE=byok
# 是否强制邮箱验证；自部署常无 SMTP，默认关闭
ANNONA_IDENTITY_REQUIRE_EMAIL_VERIFICATION=false

# ============ 会话（identity=local/platform 时生效）============
# 活跃令牌是不透明随机串、只存 Redis，没有签名/加密密钥（identity-credential-storage-adr §决策 §3）
# 滑动有效期；Cookie 名固定 ANNONA_SESSION（HttpOnly），此处不配
ANNONA_SESSION_TTL=7d
# TLS 部署（https 或反代 https）必须置 true，否则会话 Cookie 走明文信道
ANNONA_SESSION_COOKIE_SECURE=false

# ============ 模型 Provider（BYOK 时按需填写，也可在设置页录入）============
# OpenAI 兼容协议；一个 Provider 可服务 chat/embedding/asr/tts/evaluator 多种用途
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 通义千问（DashScope，OpenAI 兼容 + 语音 ASR/TTS 同源）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地模型（LM Studio / Ollama 等 OpenAI 兼容端点）
LOCAL_MODEL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL_API_KEY=not-needed

# 默认模型选择（留空则用 application.yml 中的默认值）
ANNONA_DEFAULT_CHAT_MODEL=
ANNONA_DEFAULT_EMBEDDING_MODEL=
ANNONA_DEFAULT_EVALUATOR_MODEL=

# ============ 检索后端（默认 pgvector，ES 仅作为可选实现）============
ANNONA_RETRIEVAL_BACKEND=pgvector
# ANNONA_RETRIEVAL_BACKEND=elasticsearch 时才需要
ELASTICSEARCH_URIS=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============ 可选：联网搜索降级 ============
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# ============ 服务端口与前端地址 ============
SERVER_PORT=8080
# 开发期前端 Vite 地址，用于 CORS 白名单
FRONTEND_ORIGIN=http://localhost:5173

# ============ 可观测（可选）============
OTEL_EXPORTER_OTLP_ENDPOINT=
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
