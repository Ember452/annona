#!/bin/sh
# annona pre-commit hook
#
# 唯一的动作：跑 gitleaks 扫 staged diff，检测硬编码密钥。
# 权威门禁在 CI（.github/workflows/ci.yml 的 gitleaks job + branch protection）；
# 这里是**本地第一道**，让开发者在 commit 前就看到，而不是等 3 分钟 CI 红。
#
# 激活：git config core.hooksPath .githooks  或  make setup
# 参考：docs/specs/2026-09-25-model-api-key-adr.md（项目不内置任何可用 Key）
#      AGENTS.md §0.2（绝不硬编码密钥）与 §5 提交前自查

set -eu

# 第一道：workflow YAML 自检。GitHub 对无效 workflow 是**静默不运行**（不报错、
# 不产生 check run），靠 CI 自己查 CI 配置文件是鸡生蛋问题，所以必须本地拦。
# python/PyYAML 缺失时报错而不是静默跳过（与 gitleaks 同一口径）。
if git diff --cached --name-only | grep -qE '^\.github/workflows/.*\.ya?ml$'; then
  if ! command -v python >/dev/null 2>&1; then
    printf '%s\n' "pre-commit: 本次改了 .github/workflows，需要 python 来跑 YAML 校验。" >&2
    printf '%s\n' "安装 Python 并 pip install pyyaml 后重新提交。" >&2
    exit 1
  fi
  python scripts/ci/validate-workflows.py || exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'MSG'
pre-commit hook: 未找到 gitleaks。annona 要求本地也跑密钥扫描，
且不提供跳过通道（AGENTS.md §0 禁止 --no-verify 绕过），因此本次 commit 中止。

安装（任选其一）：
  Windows: winget install Gitleaks.gitleaks
  macOS:   brew install gitleaks
  其他:    https://github.com/gitleaks/gitleaks/releases 下载对应平台二进制
           放到 PATH 上（例如 ~/.local/bin 或 /usr/local/bin）

装好后重新 git commit。
MSG
  exit 1
fi

# --staged 只扫暂存区，速度比全历史快；--redact 让命中片段脱敏，避免 hook 输出反泄漏
# --no-banner 静默模式，方便与其它 hook 输出统一格式
exec gitleaks protect --staged --no-banner --redact
