#!/bin/sh
# annona pre-commit hook
#
# 八个动作：Flyway 迁移冻结检查 → workflow YAML 结构自检 → 测试侧配置遮蔽检查 → 迁移↔基线清单登记守卫 → @Modifying 调用点事务覆盖机检 → void @Modifying×原生 SELECT 必炸组合机检 → 原生 datetime 标量硬转型机检 → gitleaks 密钥扫描。
# 权威门禁在 CI（.github/workflows/ci.yml 的 gitleaks job + branch protection）；
# 这里是**本地第一道**，让开发者在 commit 前就看到，而不是等 CI 红。
#
# 激活：git config core.hooksPath .githooks  或  make setup
# 参考：docs/specs/2026-09-25-model-api-key-adr.md（项目不内置任何可用 Key）
#      AGENTS.md §0.2（绝不硬编码密钥）与 §5 提交前自查

set -eu

# 第零道：Flyway 迁移冻结。已应用的 V<n>__*.sql 被 checksum 冻结（validate-on-migrate:
# true），修改会让所有持久库启动失败——结构变更只能新增版本号（AGENTS.md §4 约定；
# V1 曾被改两次，见 reports/2026-09-27-docker-it-假绿复盘.md §5）。删除（D）与改名（R，
# git mv 产生 R100）同样拦截：迁移链不允许断号或换名重放。
MIGRATION_DIR='annona-server/src/main/resources/db/migration'
FROZEN=$(git diff --cached --name-only --diff-filter=MDR -- "$MIGRATION_DIR" || true)
if [ -n "$FROZEN" ]; then
  printf '%s\n' "pre-commit: 已应用的 Flyway 迁移禁止修改/删除（checksum 冻结）：" >&2
  printf '%s\n' "$FROZEN" >&2
  printf '%s\n' "结构变更请新增 ${MIGRATION_DIR}/V<n+1>__*.sql（见 AGENTS.md §4）。" >&2
  exit 1
fi

# 第一道：workflow YAML 自检。GitHub 对无效 workflow 是**静默不运行**（不报错、
# 不产生 check run），靠 CI 自己查 CI 配置文件是鸡生蛋问题，所以必须本地拦。
# python/PyYAML 缺失时报错而不是静默跳过（与 gitleaks 同一口径）。
if git diff --cached --name-only | grep -qE '^\.github/workflows/.*\.ya?ml$'; then
  if ! command -v python >/dev/null 2>&1; then
    printf '%s\n' "pre-commit: 本次改了 .github/workflows，需要 python 来跑 YAML 校验。" >&2
    printf '%s\n' "安装 Python 并 pip install pyyaml 后重新提交。" >&2
    exit 1
  fi
  python scripts/ci/validate-workflows.py || exit 1
fi

# 第二道：测试侧 profile 配置遮蔽检查。test 类路径先于 main，src/test/resources 里的
# application-{profile}.yaml 会把 main 同名文件的整个 profile（KEK/datasource）静默
# 遮蔽掉（P1a-05 实测：27 个 IT 上下文死于 KEK 校验，复刻 B5 事故）。
if git diff --cached --name-only | grep -qE '^annona-server/src/test/resources/application'; then
  if ! command -v python >/dev/null 2>&1; then
    printf '%s
' "pre-commit: 本次改了测试侧 application 配置，需要 python 跑遮蔽检查。" >&2
    exit 1
  fi
  python scripts/ci/check-test-config-shadowing.py || exit 1
fi

# 第五道：迁移↔基线清单登记守卫。FlywayBaselineIT 的 containsExactlyInAnyOrder 是全库
# 清单断言，新表漏登记会让 CI docker 组假红（V2/V4/V6 三连踩，AGENTS §4 约定→机检元规则）。
# 改任一侧都触发同跑：只改迁移能拦漏登记；只改清单能拦“删登记造成清单与迁移脱钩”。
if git diff --cached --name-only | grep -qE '^annona-server/src/(main/resources/db/migration/|test/java/io/annona/integration/FlywayBaselineIT)'; then
  if ! command -v python >/dev/null 2>&1; then
    printf '%s\n' "pre-commit: 本次改了迁移或基线清单，需要 python 跑登记一致性检查。" >&2
    exit 1
  fi
  python scripts/ci/check-migration-inventory.py || exit 1
fi

# 第六道：@Modifying 调用点事务覆盖机检。Spring Data @Modifying 方法在无活动事务的
# 调用线程上必抛 TransactionRequiredException（批 2 CI 实炸 Facade.answer；恢复调度器
# 为同型潜伏雷，slice 用 mock EM 探不到）。改任一主源 .java 都重扫（纯 python、秒级）。
if git diff --cached --name-only | grep -qE '^annona-server/src/main/java/.*\.java$'; then
  if ! command -v python >/dev/null 2>&1; then
    printf '%s\n' "pre-commit: 本次改了后端主源，需要 python 跑 @Modifying 事务覆盖检查。" >&2
    exit 1
  fi
  python scripts/ci/check-modifying-callers.py || exit 1
fi

# 第七道：void @Modifying × 原生 SELECT 必炸组合。pg_advisory_xact_lock 首版写成这种形状，
# CI docker-it 实炸 7 例（executeUpdate 拒收结果集）；本机 mock EM 探不到，故上机检。
if git diff --cached --name-only | grep -qE '^annona-server/src/main/java/.*Repository\.java$'; then
  if ! command -v python >/dev/null 2>&1; then
    printf '%s\n' "pre-commit: 本次改了 Repository 接口，需要 python 跑 @Modifying×SELECT 检查。" >&2
    exit 1
  fi
  python scripts/ci/check-modifying-native-select.py || exit 1
fi

# 第八道：原生查询真库地雷。① datetime 标量硬转型：Hibernate 7（Boot 4）起原生标量
# 默认 LocalDate/LocalDateTime（6.x 默认 java.sql.*），硬转型在本机 slice 全绿、真库 CI
# 才炸（StudyStatsFlowIT 三连 ClassCastException 实测）；② 命名参数写进 GROUP BY/ORDER
# BY 表达式：PG 逐字匹配分组表达式必炸（同查询实测）。改任一主源 .java 都重扫（纯 python、秒级）。
if git diff --cached --name-only | grep -qE '^annona-(server|common|spi|infrastructure)/src/main/java/.*\.java$'; then
  if ! command -v python >/dev/null 2>&1; then
    printf '%s\n' "pre-commit: 本次改了后端主源，需要 python 跑 datetime 标量转型检查。" >&2
    exit 1
  fi
  python scripts/ci/check-native-datetime-cast.py || exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'MSG'
pre-commit hook: 未找到 gitleaks。annona 要求本地也跑密钥扫描，
且不提供跳过通道（AGENTS.md §0 禁止 --no-verify 绕过），因此本次 commit 中止。

安装（任选其一）：
  Windows: winget install Gitleaks.gitleaks
  macOS:   brew install gitleaks
  其他:    https://github.com/gitleaks/gitleaks/releases 下载对应平台二进制
           放到 PATH 上（例如 ~/.local/bin 或 /usr/local/bin）

装好后重新 git commit。
MSG
  exit 1
fi

# --staged 只扫暂存区，速度比全历史快；--redact 让命中片段脱敏，避免 hook 输出反泄漏
# --no-banner 静默模式，方便与其它 hook 输出统一格式
exec gitleaks protect --staged --no-banner --redact
